{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ada-D",
  "scopeName": "source.ada",
  "comment": "Ada-D (Ada Script) TextMate 语法。关键字/运算符列表与 crates/ada_lexer/src/lib.rs 的 KEYWORDS/OPERATORS 由 crates/ada_cli/tests/editor_grammar.rs 校验，不允许漂移（T7.1）。",
  "patterns": [
    { "include": "#comments" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ada",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ada",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "interpolated-strings": {
      "name": "string.interpolated.ada",
      "begin": "\\$\\\"",
      "end": "\\\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ada" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ada" }
      },
      "patterns": [
        {
          "name": "meta.embedded.expression.ada",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.ada" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.ada" }
          },
          "patterns": [{ "include": "$self" }]
        },
        {
          "name": "constant.character.escape.ada",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ada",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ada" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ada" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.ada",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ada",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ada",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.ada",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.ada" },
            "2": { "name": "entity.name.function.ada" }
          }
        },
        {
          "name": "meta.binding.ada",
          "match": "\\b(let|mut)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.ada" },
            "2": { "name": "variable.other.ada" }
          }
        },
        {
          "name": "meta.method-call.ada",
          "match": "\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.ada" }
          }
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.ada",
      "match": "\\b(fn|async|await|spawn|let|mut|if|else|match|while|for|in|return|ret|break|continue)\\b"
    },
    "constants": {
      "name": "constant.language.ada",
      "match": "\\b(true|false|nil|null)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ada",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.ada",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.navigation.ada",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.comparison.ada",
          "match": "==|!=|<=|>=|<<|>>"
        },
        {
          "name": "keyword.operator.assignment.compound.ada",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.logical.ada",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.ada",
          "match": "[-+*/%<>=!&|^~]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.ada",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.ada",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.ada",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.ada",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.ada",
          "match": "\\."
        }
      ]
    }
  }
}
