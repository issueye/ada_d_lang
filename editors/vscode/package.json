{
  "name": "ada-d",
  "displayName": "Ada-D (Ada Script)",
  "description": "Ada-D / Ada Script 语法高亮与实时诊断（通过 ada-lsp）",
  "version": "0.1.0",
  "publisher": "ada-d",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["ada", "ada-d", "ada script"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:ada"],
  "contributes": {
    "languages": [
      {
        "id": "ada",
        "aliases": ["Ada-D", "ada"],
        "extensions": [".ada"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ada",
        "scopeName": "source.ada",
        "path": "./syntaxes/ada.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ada-D",
      "properties": {
        "ada.lsp.path": {
          "type": "string",
          "default": "",
          "description": "ada-lsp 可执行文件的路径（留空则使用 PATH 中的 ada-lsp）"
        }
      }
    }
  }
}
